# Shani — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Secrets live here rather than in config.yaml, because config.yaml is the file
# people paste into bug reports. `shani init` generates the two tokens below.

# ─── API ─────────────────────────────────────────────────────────────────────
# Bearer token for the Shani API. Leave blank for single-user loopback (auth is
# skipped entirely when unset). Set it before exposing the API anywhere.
SHANI_SERVER__API_TOKEN=

# ─── Plane C: TradingView webhook ────────────────────────────────────────────
# Shared secret for Pine alerts. REQUIRED for the webhook to accept anything —
# an unset secret fails closed rather than open. Put this same value in the
# `secret` field of your Pine alert message.
SHANI_TRADINGVIEW__WEBHOOK_SECRET=

# ─── Model provider ──────────────────────────────────────────────────────────
# Only the one you use. Everything except the agent works with no key at all.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ─── Overrides ───────────────────────────────────────────────────────────────
# Anything in config.yaml can be overridden with SHANI_ + the nested path,
# joined by double underscores.
#
# SHANI_BROKER__DEFAULT=paper
# SHANI_RISK__MAX_DAILY_LOSS=1000
# SHANI_RISK__KILL_SWITCH=false
# SHANI_TRADINGVIEW__DESKTOP_ENABLED=true
# SHANI_TRADINGVIEW__CDP_PORT=9222
# SHANI_MODEL__PROVIDER=ollama
# SHANI_SERVER__PORT=8420

# Live trading needs BOTH of these, and the phrase must match exactly.
# Read docs/safety.md first. No live adapter is implemented in this release.
# SHANI_BROKER__ALLOW_LIVE=false
# SHANI_BROKER__LIVE_CONFIRMATION=
